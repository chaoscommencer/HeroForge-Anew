# HeroForge-Anew QA stack configuration.
#
# Copy this file to `.env` (which is git-ignored) and set a strong password.
# docker-compose.yml auto-loads `.env` from the project root, and the display
# sidecar REQUIRES VNC_PASSWORD — the stack refuses to start without it (and
# also refuses the placeholder value below).
#
# The easy path: just run `scripts/run-gui.sh`. It creates `.env` from this
# file on first launch and auto-generates a strong VNC_PASSWORD whenever the
# value is missing or still the `change-me` placeholder. Pass
# `--generate-password` to force-rotate it. After it runs, read your password
# back out of `.env`.
#
# To configure manually instead:
#
#   cp .env.example .env
#   # then edit .env and set a strong VNC_PASSWORD
#
# VNC_PASSWORD gates access to the noVNC desktop served at
# http://localhost:6080/vnc.html (loopback-only; reached via VS Code port
# forwarding). Note: VNC truncates the password to its first 8 characters (the
# length of a DES key), so only the first 8 characters are significant. Do NOT
# commit your real .env.

VNC_PASSWORD=change-me

# Optional overrides:
#
# Application log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# Set DEBUG to surface the per-row detail behind seeding warnings such as
# "skipped N source rows due to insert errors (see debug logs)".
# LOG_LEVEL=INFO
#
# Virtual desktop resolution (WIDTHxHEIGHT) for the display sidecar.
# SCREEN_GEOMETRY=1920x1080
#
# Read-only directory holding the seed source data (the bundled CSV/XLSX game
# tables). Defaults to the project's data/ folder; override to seed from an
# alternate copy of those inputs.
# HEROFORGE_DATA_SOURCE_DIR=./data
#
# Writable directory for the seeded game database and character saves. Defaults
# to the project root locally; the QA container sets it to /app/userdata (a
# persistent volume) so the rest of the filesystem can stay read-only.
# HEROFORGE_DATA_DIR=/app/userdata
#
# Align the in-container users with your host UID/GID (defaults to 1000/1000).
# These are normally exported automatically by scripts/run-gui.sh.
# APP_UID=1000
# APP_GID=1000
