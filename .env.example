# HeroForge-Anew QA stack configuration.
#
# Copy this file to `.env` (which is git-ignored) to set the optional overrides
# below. docker-compose.yml auto-loads `.env` from the project root.
#
# The VNC password is NOT configured here. scripts/run-gui.sh generates a fresh
# one-time password on every launch, prints it once, and hands it to the display
# sidecar through a short-lived tmpfs file, so it is never stored on disk (see
# docs/containerized-runtime.md, section 2). Do not add a VNC_PASSWORD line.

# Optional overrides:
#
# Application log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# Set DEBUG to surface the per-row detail behind seeding warnings such as
# "skipped N source rows due to insert errors (see debug logs)".
# LOG_LEVEL=INFO
#
# Virtual desktop resolution (WIDTHxHEIGHT) for the display sidecar.
# SCREEN_GEOMETRY=1920x1080
#
# Read-only directory holding the seed source data (the bundled CSV/XLSX game
# tables). Defaults to the project's data/ folder; override to seed from an
# alternate copy of those inputs.
# HEROFORGE_DATA_SOURCE_DIR=./data
#
# Writable directory for the seeded game database and character saves. Defaults
# to the project root locally; the QA container sets it to /app/userdata (a
# persistent volume) so the rest of the filesystem can stay read-only.
# HEROFORGE_DATA_DIR=/app/userdata
#
# Align the in-container users with your host UID/GID (defaults to 1000/1000).
# These are normally exported automatically by scripts/run-gui.sh.
# APP_UID=1000
# APP_GID=1000
