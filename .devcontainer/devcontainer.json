// HeroForge-Anew development container — DEFAULT, unprivileged profile.
//
// This is the profile for everyday development and for unattended agents. It
// runs without --privileged, without Docker-in-Docker and without sudo, with
// --security-opt=no-new-privileges, and with a root-owned, read-only Python
// environment at /opt/venv (see Dockerfile.devcontainer-default). Nothing that
// runs as `vscode` here can become root or reach the Codespace VM.
//
// The GUI for QA runs as plain processes: `scripts/run-gui-local.sh` starts the
// desktop (Xvfb + noVNC) and the app, and you open the forwarded port 6080.
//
// For the containerized Compose QA stack (scripts/run-gui.sh), which needs
// Docker-in-Docker and therefore a privileged container, use the opt-in profile
// in .devcontainer/qa/devcontainer.json. Never use that one for unattended agents.
{
  "name": "HeroForge-Anew (PyQt6 Dev)",

  "build": {
    "dockerfile": "Dockerfile.devcontainer-default",
    "context": ".."
  },

  // no-new-privileges: no setuid program (su, sudo, newuidmap, ...) can raise
  // privileges. NET_RAW and MKNOD are not needed for development.
  "runArgs": [
    "--security-opt=no-new-privileges",
    "--cap-drop=NET_RAW",
    "--cap-drop=MKNOD"
  ],

  // The venv is read-only, so the project is not pip-installed in editable mode;
  // putting src/ on PYTHONPATH gives the same imports (`python -m heroforge`).
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src"
  },

  // noVNC from scripts/run-gui-local.sh, bound to 127.0.0.1 in this container.
  // Codespaces forwards it privately (only your signed-in GitHub account can
  // open it). Keep its visibility private.
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "HeroForge GUI (noVNC)",
      "onAutoForward": "notify",
      // websockify is TLS-only (--ssl-only), so the forwarder must connect to
      // it over HTTPS; plain HTTP fails with a 502.
      "protocol": "https"
    }
  },

  // Run as the unprivileged user shipped with the base image.
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      // Recommended extensions live in .vscode/extensions.json so they can be
      // reviewed and installed manually rather than forced into the container.
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        // The dev dependencies are baked into /opt/venv by
        // Dockerfile.devcontainer-default.
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "[python]": {
          // Needs the `ms-python.black-formatter` extension (recommended in
          // .vscode/extensions.json); harmless if it is not installed.
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
