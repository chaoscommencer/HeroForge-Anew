# syntax=docker/dockerfile:1
#
# Development container image for HeroForge-Anew.
#
# This is the image GitHub Codespaces / VS Code Dev Containers build from
# devcontainer.json. It is for *developing* the project — editing, linting,
# type-checking and running the (offscreen-capable) test suite — and is distinct
# from the root Dockerfile.heroforge-app, which exists to *run* the GUI for QA.
#
# It layers the Qt runtime libraries on top of the official devcontainers Python
# image so that `pytest` can import PyQt6 for real (instead of skipping the
# widget tests). The viewable QA desktop now lives entirely in the Compose
# `display` sidecar, so no X11 client utilities (xhost) are needed here.

# Pinned to a specific digest for reproducible, tamper-evident builds. The
# human-readable tag (3-3.12-bookworm) is kept alongside the digest for clarity;
# the @sha256 is what Docker actually resolves. Available tags/digests are listed
# at https://mcr.microsoft.com/en-us/artifact/mar/devcontainers/python/tags —
# update both the tag and the digest together when bumping the base image.
FROM mcr.microsoft.com/devcontainers/python:3-3.12-bookworm@sha256:4ace5266fed54e0e440d7b5142008684e305e5d456c8136f1bae5742139a95dc

# Refresh the apt package index once, up front, so the install RUNs below do not
# each repeat it. Each install RUN sets `export DEBIAN_FRONTEND=noninteractive`
# in its own shell (it does NOT persist across RUN layers) so any package that
# would otherwise prompt via debconf installs noninteractively.
RUN apt-get update

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get install --no-install-recommends -y \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libdbus-1-3 \
        libfontconfig1 \
        libfreetype6 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcb-cursor0 \
        libxcb-glx0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-shm0 \
        libxcb-sync1 \
        libxcb-util1 \
        libxcb-xfixes0 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxext6 \
        libxrender1 \
        libsm6 \
        libice6

# Whether to bake the rootless-Podman runtime packages into the image. Set by
# devcontainer.json (build.args.INSTALL_PODMAN_DEPS) and overridable per build
# with `--build-arg INSTALL_PODMAN_DEPS=false`. Front-loading these here (rather
# than apt-installing them at postCreate via scripts/setup-podman.sh) bakes them
# into a cached layer, so container creation is faster and does not depend on a
# network fetch — and the QA stack's preferred Podman engine works on first boot
# even if the optional setup-podman.sh step is skipped or fails. Set to "false"
# to keep the image lean when only the Docker-in-Docker QA path will be used;
# scripts/setup-podman.sh still installs whatever is missing at postCreate.
ARG INSTALL_PODMAN_DEPS=true

# Rootless Podman + its runtime prerequisites (only when INSTALL_PODMAN_DEPS is
# true). These mirror the apt packages in scripts/setup-podman.sh section 1:
#   * podman           — the container engine itself.
#   * uidmap           — newuidmap/newgidmap setuid helpers rootless Podman needs.
#   * fuse-overlayfs   — nested-friendly storage driver (kernel overlay is
#                        usually unavailable inside the dev container).
#   * slirp4netns      — rootless user-mode networking.
#   * crun             — OCI runtime that starts containers gracefully when no
#                        cgroup v2 controllers are delegated (the default runc
#                        aborts). See setup-podman.sh section 4.
#   * catatonit        — container-init binary that `init: true` needs; bookworm
#                        installs it at /usr/libexec/podman/catatonit (Podman's
#                        default init_path). See setup-podman.sh section 1.
# Per-user/identity configuration (subuid/subgid ranges, storage.conf,
# containers.conf, podman-compose) is deliberately NOT done here — it is
# per-user state that does not belong in a shared image layer, so it stays in
# scripts/setup-podman.sh, whose `command -v` guards make the package installs
# above harmless no-ops when already present.
RUN if [ "${INSTALL_PODMAN_DEPS}" = "true" ]; then \
        export DEBIAN_FRONTEND=noninteractive \
        && apt-get install --no-install-recommends -y \
            podman \
            uidmap \
            fuse-overlayfs \
            slirp4netns \
            crun \
            catatonit; \
    else \
        echo "INSTALL_PODMAN_DEPS=${INSTALL_PODMAN_DEPS}: skipping Podman runtime packages (scripts/setup-podman.sh will install them at postCreate if needed)."; \
    fi

# Clean the apt cache and drop the package lists once, at the very end, so every
# layer above shares a single cleanup instead of repeating it per install.
RUN apt-get clean \
    && rm -rf /var/lib/apt/lists/*

