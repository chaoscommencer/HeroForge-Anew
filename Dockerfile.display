# syntax=docker/dockerfile:1
#
# Display sidecar image for the HeroForge-Anew QA stack.
#
# This container hosts the ENTIRE viewable desktop stack — a virtual X server
# (Xvfb), a lightweight window manager (fluxbox), a VNC server (x11vnc) and the
# noVNC web client (served by websockify). The companion `app` container runs
# only the Qt application and draws into this container's X server over a shared
# /tmp/.X11-unix volume; it never hosts a remote-viewable desktop itself.
#
# Why a separate container: a noVNC session lands HERE, in an image that carries
# no application source and no workspace bind mounts, instead of next to the
# VS Code server / repo / credentials (which is what the devcontainer's
# desktop-lite feature used to do). Human access is gated by a required VNC
# password (see scripts/display-entrypoint.sh and .env.example).

FROM debian:bookworm-slim

# --- Display stack packages --------------------------------------------------
# xvfb       : headless X server that renders to an in-memory framebuffer
# fluxbox    : minimal window manager so the Qt window has focus/decorations
# x11vnc     : exports the Xvfb display over the VNC (RFB) protocol
# novnc      : the browser-based VNC client (HTML/JS served as static files)
# websockify : bridges noVNC's WebSocket traffic to x11vnc's TCP socket
# x11-utils  : provides xdpyinfo, used to probe X-server readiness / healthcheck
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        xvfb \
        fluxbox \
        x11vnc \
        novnc \
        websockify \
        x11-utils \
        procps \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# --- Unprivileged user -------------------------------------------------------
# UID/GID are build args so they can be aligned with the host/devcontainer and
# the `app` container, keeping ownership of the shared X11 socket consistent.
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --shell /bin/bash app

# The shared X11 socket directory. Created 1777 (sticky, world-writable) in the
# image so that when Compose initializes the empty `x11-socket` named volume from
# this path it inherits those permissions — letting the non-root Xvfb here and
# the non-root Qt process in the `app` container both use the socket.
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

COPY scripts/display-entrypoint.sh /usr/local/bin/display-entrypoint.sh
RUN chmod +x /usr/local/bin/display-entrypoint.sh

USER app

# DISPLAY :99 is the in-container virtual X server; the geometry is overridable.
# PYTHONUNBUFFERED surfaces websockify logs immediately for QA.
ENV DISPLAY=:99 \
    SCREEN_GEOMETRY=1920x1080 \
    NOVNC_PORT=6080 \
    VNC_PORT=5900 \
    PYTHONUNBUFFERED=1

CMD ["/usr/local/bin/display-entrypoint.sh"]
